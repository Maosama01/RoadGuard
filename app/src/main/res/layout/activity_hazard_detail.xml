<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back"
            app:tint="@color/ink" />

        <TextView
            android:id="@+id/txtToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <ImageButton
            android:id="@+id/btnDirections"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_open_in_maps"
            android:src="@drawable/ic_open"
            app:tint="@color/ink" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/asphalt">

                    <ImageView
                        android:id="@+id/imgPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:contentDescription="@string/detail_photo"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/txtNoPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/detail_no_photo"
                        android:textColor="@color/on_asphalt_muted"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/gutter"
                    android:paddingTop="18dp"
                    android:paddingEnd="@dimen/gutter">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/barlow_condensed_bold"
                            android:includeFontPadding="false"
                            android:textSize="58sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtSeverityWord"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceTitleLarge" />

                            <TextView
                                style="@style/TextAppearance.RoadGuard.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detail_score_caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtRoad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                    <TextView
                        android:id="@+id/txtSummary"
                        style="@style/TextAppearance.RoadGuard.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp" />

                    <!-- Reported -> Verified -> Crew assigned -> Fixed -->
                    <LinearLayout
                        android:id="@+id/stages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/txtStatusNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/factDrivers"
                                    layout="@layout/item_stat"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1" />

                                <include
                                    android:id="@+id/factSightings"
                                    layout="@layout/item_stat"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/factAge"
                                    layout="@layout/item_stat"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1" />

                                <include
                                    android:id="@+id/factJolt"
                                    layout="@layout/item_stat"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Who fixes this: contractor, tender, officer, deadline -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardWho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                style="@style/TextAppearance.RoadGuard.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/who_title"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/txtContractor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="?attr/textAppearanceTitleLarge" />

                            <TextView
                                android:id="@+id/txtContractorPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:minHeight="48dp"
                                android:gravity="center_vertical"
                                android:textColor="@color/info"
                                android:textSize="15sp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/txtTender"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/txtWard"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/txtOfficer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/txtOfficerContact"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:minHeight="48dp"
                                android:gravity="center_vertical"
                                android:textColor="@color/info"
                                android:textSize="15sp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/txtDue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/txtEscalation"
                                style="@style/TextAppearance.RoadGuard.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/txtWarranty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_chip"
                                android:paddingStart="14dp"
                                android:paddingTop="10dp"
                                android:paddingEnd="14dp"
                                android:paddingBottom="10dp"
                                android:text="@string/who_warranty"
                                android:textSize="14sp"
                                android:visibility="gone" />

                            <!-- Before and after, once the contractor uploads the repair photo -->
                            <LinearLayout
                                android:id="@+id/repairPhotos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <LinearLayout
                                    android:id="@+id/colBefore"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:id="@+id/imgBefore"
                                        android:layout_width="match_parent"
                                        android:layout_height="120dp"
                                        android:background="@drawable/bg_thumb"
                                        android:contentDescription="@string/who_before"
                                        android:scaleType="centerCrop" />

                                    <TextView
                                        style="@style/TextAppearance.RoadGuard.Caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="@string/who_before" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:id="@+id/imgAfter"
                                        android:layout_width="match_parent"
                                        android:layout_height="120dp"
                                        android:background="@drawable/bg_thumb"
                                        android:contentDescription="@string/who_repair_photo"
                                        android:scaleType="centerCrop" />

                                    <TextView
                                        style="@style/TextAppearance.RoadGuard.Caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="@string/who_after" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Complaint and public link -->
                    <LinearLayout
                        android:id="@+id/rowShare"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnComplaint"
                            style="@style/Widget.RoadGuard.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/send_complaint" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShareLink"
                            style="@style/Widget.RoadGuard.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/share_link" />
                    </LinearLayout>

                    <!-- Vote -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardVote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:id="@+id/txtVoteTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/vote_title_open"
                                android:textAppearance="?attr/textAppearanceTitleMedium" />

                            <TextView
                                android:id="@+id/txtVoteBody"
                                style="@style/TextAppearance.RoadGuard.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/vote_body_default"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPresent"
                                    style="@style/Widget.RoadGuard.Button.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/vote_still_there" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnFixed"
                                    style="@style/Widget.RoadGuard.Button"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:text="@string/vote_its_fixed" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/TextAppearance.RoadGuard.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/detail_history" />

                    <LinearLayout
                        android:id="@+id/timeline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/txtLoadError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
