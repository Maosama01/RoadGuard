<?xml version="1.0" encoding="utf-8"?>
<!--
  The RoadGuard backend usually runs on a laptop on the same Wi-Fi, over plain http://
  (e.g. http://192.168.1.20:5000/). Android blocks plain HTTP by default, so it is allowed here.
  For a public deployment, put the backend behind HTTPS and set cleartextTrafficPermitted to false.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
