<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older. The sign-in token and device id must never be restored onto another
  phone (it would become the same guest account), and the offline queue points at photo files
  that a restore does not bring back.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="roadguard_session.xml" />
    <exclude domain="database" path="." />
</full-backup-content>
