<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds talk to the public server over HTTPS only, so passwords and sign-in tokens
  never travel in plain text. Debug builds override this file (src/debug/res/xml) to allow
  http:// to a backend on the same Wi-Fi.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
