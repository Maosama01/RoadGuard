# Copy this file to .env and change the values.

# Port the API listens on. The Android app's "Server address" setting must point here,
# e.g. http://192.168.1.20:5000/ (your computer's LAN IP, not localhost).
PORT=5000

# Long random string used to sign login tokens. CHANGE THIS before real use.
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database and uploaded photos live.
DATA_DIR=./data

# Optional: creates (or updates) an admin account for the authority dashboard on startup.
ADMIN_EMAIL=admin@roadguard.local
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=City Roads Admin

# Public base URL used when building photo links. Leave empty to derive it from each request.
PUBLIC_BASE_URL=

# Optional: link for "Get the RoadGuard app" on public hazard pages (e.g. your Play Store listing).
APP_URL=

# Used by docker-compose.yml: the domain Caddy gets an HTTPS certificate for.
# PUBLIC_BASE_URL is set to https://$DOMAIN automatically there.
DOMAIN=
