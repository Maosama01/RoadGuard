<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rules as backup_rules.xml, for cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="roadguard_session.xml" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="roadguard_session.xml" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
